from collections.abc import Callable
from typing import Final

class EngineError(RuntimeError): ...
class AssetError(EngineError): ...
class MissingAssetError(AssetError): ...
class InvalidEntityError(ReferenceError): ...
class PhysicsError(EngineError): ...
class NetworkError(EngineError): ...

def _network_backend_info() -> tuple[bool, str, str, str]: ...
def _network_backend_smoke_test() -> bool: ...

_NativeNetworkEvent = tuple[str, int, str, bytes, str, int, int]
_NativeNetworkStats = tuple[int, int, int, int, int, int, int]
_NativeNetworkMetrics = tuple[
    str, int, float, float, int, int, int, _NativeNetworkStats
]

class _NetworkClient:
    def __init__(
        self,
        connection_timeout_seconds: float = 5.0,
        event_queue_capacity: int = 1024,
        maximum_message_size: int = 65536,
        protocol_version: int = 1,
        schema_version: int = 1,
    ) -> None: ...
    def connect(self, address: str, port: int) -> None: ...
    def send(self, connection: int, data: bytes, delivery: str) -> str: ...
    def disconnect(self, connection: int, reason: str = "") -> None: ...
    def poll(self, maximum_events: int = 256) -> list[_NativeNetworkEvent]: ...
    @property
    def connection(self) -> int: ...
    @property
    def state(self) -> str: ...
    @property
    def remote_address(self) -> str: ...
    @property
    def stats(self) -> _NativeNetworkStats: ...
    @property
    def metrics(self) -> _NativeNetworkMetrics: ...

class _NetworkServer:
    def __init__(
        self,
        bind_address: str = "0.0.0.0",
        port: int = 7777,
        maximum_connections: int = 32,
        handshake_timeout_seconds: float = 5.0,
        event_queue_capacity: int = 4096,
        maximum_message_size: int = 65536,
        protocol_version: int = 1,
        schema_version: int = 1,
    ) -> None: ...
    def start(self) -> None: ...
    def stop(self, reason: str = "server stopped") -> None: ...
    def send(self, connection: int, data: bytes, delivery: str) -> str: ...
    def disconnect(self, connection: int, reason: str = "") -> None: ...
    def poll(self, maximum_events: int = 256) -> list[_NativeNetworkEvent]: ...
    @property
    def state(self) -> str: ...
    @property
    def port(self) -> int: ...
    @property
    def bind_address(self) -> str: ...
    @property
    def connections(self) -> tuple[int, ...]: ...
    @property
    def stats(self) -> _NativeNetworkStats: ...

class _NetworkSimulator:
    def __init__(
        self,
        latency_seconds: float = 0.0,
        jitter_seconds: float = 0.0,
        loss_probability: float = 0.0,
        random_seed: int = 1,
        in_flight_capacity: int = 1024,
        event_queue_capacity: int = 1024,
        maximum_message_size: int = 65536,
    ) -> None: ...
    @property
    def first_connection(self) -> int: ...
    @property
    def second_connection(self) -> int: ...
    def send(
        self, first: bool, connection: int, data: bytes, delivery: str
    ) -> str: ...
    def disconnect(
        self, first: bool, connection: int, reason: str = ""
    ) -> None: ...
    def poll(
        self, first: bool, maximum_events: int = 256
    ) -> list[_NativeNetworkEvent]: ...
    def stats(self, first: bool) -> _NativeNetworkStats: ...
    def advance(self, elapsed_seconds: float) -> None: ...
    @property
    def time_seconds(self) -> float: ...
    @property
    def in_flight_count(self) -> int: ...

class _TextureColorSpace:
    LINEAR: Final[_TextureColorSpace]
    SRGB: Final[_TextureColorSpace]

def _load_image_info(
    path: str, color_space: _TextureColorSpace
) -> tuple[str, int, int, int, bool]: ...

class _TextureCache:
    def __init__(self) -> None: ...
    def load(
        self, path: str, color_space: _TextureColorSpace
    ) -> tuple[str, int, int, int, bool]: ...
    def clear(self) -> None: ...
    @property
    def size(self) -> int: ...

_NativeModelInfo = tuple[
    str,
    int,
    list[tuple[str, int, int, int, int]],
    list[tuple[str, tuple[float, float, float, float], str | None]],
    list[str],
]

def _load_obj_info(path: str) -> _NativeModelInfo: ...

class _ModelCache:
    def __init__(self) -> None: ...
    def load(self, path: str) -> _NativeModelInfo: ...
    def clear(self) -> None: ...
    @property
    def size(self) -> int: ...

def engine_version() -> str: ...
def native_add(a: int, b: int) -> int: ...
def _raise_engine_error(message: str) -> None: ...
def _quat_from_euler(x: float, y: float, z: float) -> tuple[float, float, float, float]: ...
def _quat_to_euler(
